<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Borealis</AssemblyName>
    <RootNamespace>Borealis.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon for the tray icon / für das Tray-Symbol -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- App and window icon, made with tools\make_icon.ps1 / Programmsymbol, erzeugt mit tools\make_icon.ps1 -->
    <ApplicationIcon>Assets\Borealis.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- For the tray icon / Für das Tray-Symbol -->
    <Resource Include="Assets\Borealis.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- No global WinForms usings, they clash with WPF / Keine globalen WinForms-Usings, sie kollidieren mit WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Borealis.Core\Borealis.Core.csproj" />
  </ItemGroup>

</Project>
