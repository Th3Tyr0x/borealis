<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Helles Farbschema: helle Flächen, rote Akzente -->
    <Color x:Key="Bg0Color">#EBEBEF</Color>
    <Color x:Key="Bg1Color">#F7F7F9</Color>
    <Color x:Key="Bg2Color">#FFFFFF</Color>
    <Color x:Key="Bg3Color">#E6E6EB</Color>
    <!-- Rahmen kräftiger als im dunklen Schema: auf Weiß verschwinden helle Grautöne -->
    <Color x:Key="LineColor">#B9B9C4</Color>
    <Color x:Key="AccentColor">#E3173E</Color>
    <Color x:Key="TextColor">#17171B</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="#F0385B" />
    <SolidColorBrush x:Key="AccentSoft" Color="#26E3173E" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDim" Color="#50505A" />
    <SolidColorBrush x:Key="TextMute" Color="#85858F" />
    <SolidColorBrush x:Key="Good" Color="#1E9E6E" />
    <SolidColorBrush x:Key="Warn" Color="#C27400" />

    <DropShadowEffect x:Key="AccentGlow" Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
    <!-- Leuchten unter dem aktiven Seitenreiter -->
    <LinearGradientBrush x:Key="TabGlow" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#33E3173E" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
