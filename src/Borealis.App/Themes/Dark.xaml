<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme: dark surfaces, red accents / Dunkles Schema: dunkle Flächen, rote Akzente -->
    <Color x:Key="Bg0Color">#0B0B0E</Color>
    <Color x:Key="Bg1Color">#121216</Color>
    <Color x:Key="Bg2Color">#19191E</Color>
    <Color x:Key="Bg3Color">#23232A</Color>
    <Color x:Key="LineColor">#2E2E36</Color>
    <Color x:Key="AccentColor">#FF1F44</Color>
    <Color x:Key="TextColor">#ECECEF</Color>

    <SolidColorBrush x:Key="Bg0" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF4D69" />
    <SolidColorBrush x:Key="AccentSoft" Color="#33FF1F44" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDim" Color="#A0A0A8" />
    <SolidColorBrush x:Key="TextMute" Color="#6C6C75" />
    <SolidColorBrush x:Key="Good" Color="#2BC48A" />
    <SolidColorBrush x:Key="Warn" Color="#F5A623" />

    <DropShadowEffect x:Key="AccentGlow" Color="{StaticResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55" />
    <!-- Glow under the active sidebar item / Leuchten unter dem aktiven Seitenreiter -->
    <LinearGradientBrush x:Key="TabGlow" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#552A0A12" Offset="0" />
        <GradientStop Color="#001A0A0E" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
