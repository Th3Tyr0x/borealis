<Project>
  <!-- Gemeinsame Einstellungen: Windows-only, x64 (die ENE-RAM-HAL ist eine x64-In-proc-DLL) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <Company>Borealis</Company>
    <Product>Borealis</Product>
    <Copyright>Copyright (C) 2026 The Borealis contributors</Copyright>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
