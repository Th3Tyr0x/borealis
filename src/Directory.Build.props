<Project>
  <!-- Shared settings: Windows only, x64 (the ENE RAM HAL is an x64 in-proc DLL) / Gemeinsame Einstellungen: nur Windows, x64 -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <Company>Borealis</Company>
    <Product>Borealis</Product>
    <Copyright>Copyright (C) 2026 The Borealis contributors</Copyright>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
